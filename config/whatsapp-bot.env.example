# Plantilla versionada. Copia las variables necesarias a .env en la raíz o inyéctalas al proceso.
# Los valores del entorno del proceso prevalecen sobre los de .env.

# Identificadores de referencia de Meta (no son credenciales de autenticación).
META_APP_ID=REPLACE_WITH_META_APP_ID
META_BUSINESS_ID=REPLACE_WITH_META_BUSINESS_ID
WA_BUSINESS_ACCOUNT_ID=REPLACE_WITH_WHATSAPP_BUSINESS_ACCOUNT_ID
WA_TEST_PHONE_NUMBER=REPLACE_WITH_META_TEST_PHONE
# Número que identifica al bot en la UI local; en producción usa el número empresarial verificado.
WA_DISPLAY_PHONE_NUMBER=

# Credenciales privadas requeridas para el webhook y WhatsApp Cloud API.
WA_APP_SECRET=REPLACE_WITH_META_APP_SECRET
# 32 bytes aleatorios (64 caracteres hexadecimales); mantener estable.
WA_PREFERENCES_HMAC_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS_AND_KEEP_STABLE
WA_VERIFY_TOKEN=REPLACE_WITH_RANDOM_WEBHOOK_VERIFY_TOKEN
WA_ACCESS_TOKEN=REPLACE_WITH_WHATSAPP_CLOUD_API_TOKEN
WA_PHONE_NUMBER_ID=REPLACE_WITH_META_PHONE_NUMBER_ID
WA_GRAPH_API_VERSION=REPLACE_WITH_SUPPORTED_GRAPH_VERSION

# Configuración del despliegue local/servidor.
WA_PORT=8080
WA_WEBHOOK_MAX_BODY_BYTES=1048576
WA_OPENAI_MODERATION_TIMEOUT_SECONDS=12
WA_OPENAI_RESPONSE_TIMEOUT_SECONDS=25
WA_WHATSAPP_REQUEST_TIMEOUT_SECONDS=20

# Chatbot general opcional (OpenAI Responses API). La clave es privada.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
