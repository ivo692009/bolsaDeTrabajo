{
  "name": "bolsa-de-trabajo-admin-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Panel administrativo local para la plataforma de intermediación de servicios",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
